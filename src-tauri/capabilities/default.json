{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "shell:allow-open",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "updater:default",
    "process:default"
  ]
}