{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "fybros-kutumb-web-app",
    "version": "0.1.0",
    "identifier": "com.fybros.kutumb",
    "build": {
        "frontendDist": "../build",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run start:dev",
        "beforeBuildCommand": "npm run build:prod"
    },
    "app": {
        "windows": [
            {
                "title": "Fybros Kutumb",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        },
        "macOS": {
            "signingIdentity": "Developer ID Application: Munish Chandel (39MQ5QH6QY)",
            "entitlements": null,
            "exceptionDomain": null
        }
    }
}